{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experience",
  "type": "object",
  "required": ["id", "name", "category", "url", "flow", "capturedAt", "status", "steps", "rubricVersion"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "category": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "flow": { "type": "string", "description": "e.g. start free trial to first product added" },
    "capturedAt": { "type": "string" },
    "status": { "enum": ["captured", "evaluated", "blocked"] },
    "blockedReason": { "type": "string" },
    "rubricVersion": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["n", "title", "url", "screenshot"],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "screenshot": { "type": "string" },
          "mobileScreenshot": { "type": "string" },
          "elapsedMs": { "type": "integer" },
          "clicks": { "type": "integer" },
          "fieldsFilled": { "type": "integer" },
          "note": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "verdict", "step"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string" },
          "verdict": { "enum": ["proven", "plausible", "unsupported"] },
          "step": { "type": "integer" },
          "evidenceStep": { "type": ["integer", "null"] }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["score", "evidence"],
        "additionalProperties": false,
        "properties": {
          "score": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
          "evidence": { "type": "string" },
          "step": { "type": ["integer", "null"] }
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "pros": { "type": "array", "items": { "type": "string" } },
        "cons": { "type": "array", "items": { "type": "string" } },
        "howItSells": { "type": "string" },
        "copy": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "tactics": { "type": "array", "items": { "type": "string" } },
        "confidence": { "enum": ["low", "medium", "high"] },
        "unknowns": { "type": "array", "items": { "type": "string" } },
        "hypothesis": {
          "type": "object",
          "required": ["statement", "metric", "guardrail", "decisionRule"],
          "additionalProperties": false,
          "properties": {
            "statement": { "type": "string" },
            "metric": { "type": "string" },
            "guardrail": { "type": "string" },
            "decisionRule": { "type": "string" }
          }
        }
      }
    },
    "sources": { "type": "array", "items": { "type": "string" } }
  }
}
