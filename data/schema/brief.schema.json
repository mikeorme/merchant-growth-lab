{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brief",
  "type": "object",
  "required": ["date", "headline", "featured", "batch", "questionsForReader"],
  "additionalProperties": false,
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "headline": { "type": "string" },
    "oneLiner": { "type": "string" },
    "featured": { "type": "string", "description": "experience id" },
    "batch": { "type": "array", "items": { "type": "string" }, "description": "other experience ids processed today (backlog batch)" },
    "newFromNews": { "type": "array", "items": { "type": "object", "required": ["name", "url", "why"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "url": { "type": "string" }, "why": { "type": "string" } } } },
    "questionsForReader": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
    "cost": { "type": "object", "additionalProperties": true }
  }
}
