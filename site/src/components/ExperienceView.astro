---
import { rubric, dims, accession, overall, base, stale, type Experience } from '../lib/data';
interface Props { exp: Experience; questions?: string[]; level?: 1 | 2 }
const { exp, questions = [], level = 1 } = Astro.props;
const Title = level === 1 ? 'h1' : 'h2';
const acc = accession(exp.id);
const steps = exp.steps;
const mobile = steps.find((s) => s.mobileScreenshot);
const read = exp.read;
const claims = exp.claims ?? [];
const ov = overall(exp);
const track = (score: number | null) => (score === null ? null : ((score - 1) / 4) * 88 + 6);
const KIND_LABEL: Record<string, string> = { home: 'Home', pricing: 'Pricing', product: 'Product', platform: 'Platform', solutions: 'Solutions', customers: 'Customers', company: 'Company', resources: 'Resources', signup: 'Signup' };
const kl = (k?: string) => KIND_LABEL[k ?? ''] ?? 'Page';
const hostPath = (u: string) => { try { const x = new URL(u); return x.host.replace(/^www\./, '') + (x.pathname === '/' ? '' : x.pathname); } catch { return u; } };
const END_LABEL: Record<string, string> = { 'account-form': 'a real account form', 'email-capture': 'an email box, not yet an account form', 'no-form': 'a page with no form', 'no-navigation': 'a button that stayed on the same page', 'no-signup-path': '' };
const end = exp.signupEnd;
const dossier = exp.dossier;
const navByKind = Object.entries((exp.navMap ?? []).reduce((acc: Record<string, string[]>, l) => { (acc[l.kind] ??= []).includes(l.label) || acc[l.kind].push(l.label); return acc; }, {}));
const payload = { id: exp.id, steps: steps.map((s) => ({ n: s.n, kind: kl(s.kind), path: hostPath(s.url), title: s.title })) };
---
<article data-exp={exp.id}>
  <div class="kicker">
    <span class="label">{acc}</span>
    <span class="label">{exp.category.replace(/-/g, ' ')}</span>
    <span class="label">Captured <span class="num">{exp.capturedAt}</span></span>
    {exp.surveyMode === 'lite' && <span class="label">Brief survey</span>}
    {exp.status === 'blocked' && <span class="stamp">Blocked</span>}
    {stale(exp) && <span class="stamp">Capture may be stale</span>}
  </div>
  <Title class="exp-title">{exp.name}</Title>
  <p class="lead exp-sub"><a href={exp.url} rel="noopener noreferrer">{exp.url.replace(/^https?:\/\//, '')}</a></p>

  <section class="sec" aria-labelledby="s-plates">
    <h2 id="s-plates">Site Survey</h2>
    <p class="mute" style="margin-top:0">Pages are followed from the site's own top-level navigation, then the signup path. Logged out; nothing is entered or bought.</p>
    {steps.length === 0 ? <p class="wall">No pages captured. {exp.blockedReason}</p> : (
    <div class="cols">
      <div>
        <figure class="plate" id="stage">
          <img id="stage-img" src={base(steps[0].screenshot)} width="1280" height="800" alt={`${exp.name} home page`} />
          <figcaption class="label" id="stage-cap"></figcaption>
        </figure>
        <div class="ribbon" aria-live="polite" id="ribbon"></div>
        <div class="ruler"><input id="scrub" type="range" min="1" max={steps.length} value="1" aria-label="Scrub through pages" aria-valuetext="Page 1" /></div>
        <div class="strip" role="listbox" aria-label="Pages">
          {steps.map((s) => (
            <button type="button" role="option" aria-selected={s.n === 1 ? 'true' : 'false'} data-step={s.n}>
              <img src={base(s.screenshot)} width="148" height="92" alt="" loading={s.n > 3 ? 'lazy' : 'eager'} />
              <span class="label">{s.n} · {kl(s.kind)}</span>
            </button>
          ))}
        </div>
        <p class="note-step" id="note-step"></p>
      </div>
      <aside class="margin" aria-label="Survey notes">
        <dl>
          <dt class="label">Pages surveyed</dt><dd class="num">{steps.length}{exp.surveyMode === 'lite' ? ' (brief)' : ''}</dd>
          <dt class="label">Sections covered</dt><dd>{[...new Set(steps.map((s) => kl(s.kind)))].join(', ')}</dd>
          {end && <><dt class="label">Signup path</dt><dd>{end.state === 'no-signup-path' ? 'No signup button found in the surveyed pages.' : <>Ends at {END_LABEL[end.state] ?? end.state}{end.clicks ? <>, <span class="num">{end.clicks}</span> click{end.clicks === 1 ? '' : 's'} from home</> : null}.</>}{exp.signupPath ? <span class="signup-note"> {exp.signupPath}</span> : null}</dd></>}
          {exp.stack?.signals?.length || exp.stack?.server ? <><dt class="label">Front-end signals</dt><dd>{[...(exp.stack?.signals ?? []), exp.stack?.server && `server: ${exp.stack.server}`, exp.stack?.generator].filter(Boolean).join(', ')}</dd></> : null}
        </dl>
        {mobile && (
          <figure class="plate" style="margin-top:24px;max-width:200px">
            <img src={base(mobile.mobileScreenshot!)} width="390" height="844" alt={`${exp.name} page ${mobile.n} on a phone`} loading="lazy" />
            <figcaption class="label">Pl. m1 · phone · page <span class="num">{mobile.n}</span></figcaption>
          </figure>
        )}
      </aside>
    </div>)}
  </section>

  {questions.length > 0 && (
    <section class="sec" aria-labelledby="s-q">
      <h2 id="s-q">Questions to take to the survey</h2>
      <ol class="lead" style="font-size:var(--t-body)">{questions.map((q) => <li>{q}</li>)}</ol>
    </section>
  )}

  {dossier && (
  <section class="sec dossier" aria-labelledby="s-dossier">
    <h2 id="s-dossier">Site messaging</h2>
    {dossier.sections.map((sec) => (
      <div class="dsec">
        <h3>{sec.title}</h3>
        <p class="lead" style="font-size:var(--t-body)">{sec.summary}</p>
        {sec.keyPoints.length > 0 && <ul class="points">{sec.keyPoints.map((k) => <li>{k}</li>)}</ul>}
        {sec.table && (
          <div class="tablewrap"><table class="dtable">
            <thead><tr>{sec.table.columns.map((c) => <th>{c}</th>)}</tr></thead>
            <tbody>{sec.table.rows.map((r) => <tr>{r.map((cell, i) => i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
          </table></div>
        )}
        {sec.gaps && sec.gaps.length > 0 && <p class="mute"><span class="label">Not covered:</span> {sec.gaps.join(' · ')}</p>}
      </div>
    ))}
    {navByKind.length > 0 && (
      <details class="sitemap"><summary class="label">Site map the survey followed ({(exp.navMap ?? []).length} links)</summary>
        <dl>{navByKind.map(([k, v]) => <><dt class="label">{k}</dt><dd>{v.slice(0, 18).join(' · ')}</dd></>)}</dl>
      </details>
    )}
  </section>)}

  <section class="sec" id="read" aria-labelledby="s-read">
    <h2 id="s-read">The Lab's notes</h2>
    {!read ? <p>Not yet examined.</p> : (<>
      <p class="lead lab-voice">{read.summary}</p>
      <div class="legend"><span><span class="dot lab"></span>Lab</span><span class="mute">Confidence: {read.confidence}</span>{ov && <span class="mute num">Lab mean {ov.mean.toFixed(1)} over {ov.n} of {dims.length}</span>}</div>
      <div class="tablewrap"><table>
        <thead><tr><th>Dimension</th><th>Scale 1 to 5</th><th>Lab</th><th>Evidence</th></tr></thead>
        <tbody>
          {rubric.lenses.map((l) => (<>
            <tr><td colspan="4" class="label" style="padding-top:20px">{l.label}</td></tr>
            {l.dimensions.map((d) => {
              const s = exp.scores?.[d.id];
              const pos = track(s?.score ?? null);
              return (
                <tr>
                  <td>{d.label}</td>
                  <td><div class="track" aria-hidden="true">{[0, 1, 2, 3, 4].map((i) => <i style={`left:${6 + i * 22}%`}></i>)}{pos !== null && <span class="dot lab" style={`left:${pos}%`}></span>}</div></td>
                  <td class="numc">{s?.score == null ? <span class="nt">n/t</span> : s.score}</td>
                  <td>{s?.evidence}{s?.step ? <> <a href={`#step=${s.step}`} data-jump={s.step} class="num">pl. {s.step}</a></> : null}</td>
                </tr>
              );
            })}
          </>))}
        </tbody>
      </table></div>

      <h3 style="margin-top:var(--s-8)">How it sells</h3>
      <p>{read.howItSells}</p>
      <div class="proscons" style="margin-top:var(--s-6)">
        <div><h3 style="font-size:var(--t-lead)">What works</h3><ul class="pros">{read.pros.map((p: string) => <li>{p}</li>)}</ul></div>
        <div><h3 style="font-size:var(--t-lead)">What doesn't</h3><ul class="cons">{read.cons.map((p: string) => <li>{p}</li>)}</ul></div>
      </div>
      {read.subjects && (['merchandising', 'design'] as const).filter((k) => read.subjects[k]).map((k) => (
        <div style="margin-top:var(--s-8)">
          <h3 style="text-transform:capitalize">{k}</h3>
          <p>{read.subjects[k].summary}</p>
          <div class="proscons" style="margin-top:var(--s-4)">
            <div><h4 class="label">What works</h4><ul class="pros">{read.subjects[k].pros.map((p: string) => <li>{p}</li>)}</ul></div>
            <div><h4 class="label">What doesn't</h4><ul class="cons">{read.subjects[k].cons.map((p: string) => <li>{p}</li>)}</ul></div>
          </div>
        </div>
      ))}
      {(read.copy?.length || read.avoid?.length) && (
        <div class="proscons" style="margin-top:var(--s-6)">
          <div><h3 style="font-size:var(--t-lead)">Worth copying</h3><ul class="pros">{(read.copy ?? []).map((p: string) => <li>{p}</li>)}</ul></div>
          <div><h3 style="font-size:var(--t-lead)">Worth avoiding</h3><ul class="cons">{(read.avoid ?? []).map((p: string) => <li>{p}</li>)}</ul></div>
        </div>
      )}

      {claims.length > 0 && (<>
        <h3 style="margin-top:var(--s-8)">Claims against evidence</h3>
        <div class="tablewrap"><table>
          <thead><tr><th>Claim as written</th><th>Verdict</th><th>Seen at</th><th>Evidence</th></tr></thead>
          <tbody>{claims.map((c) => (
            <tr><td>“{c.text}”</td><td><span class={`verdict-word v-${c.verdict}`}>{c.verdict}</span></td>
            <td class="numc"><a href={`#step=${c.step}`} data-jump={c.step}>pl. {c.step}</a></td>
            <td class="numc">{c.evidenceStep ? <a href={`#step=${c.evidenceStep}`} data-jump={c.evidenceStep}>pl. {c.evidenceStep}</a> : 'none on page'}</td></tr>
          ))}</tbody>
        </table></div>
      </>)}

      <div class="cols" style="margin-top:var(--s-8)">
        <div>
          <h3>Hypothesis to test</h3>
          <div class="hyp" id="hyp">
            <p class="lab-voice" id="hyp-statement" style="margin:0">{read.hypothesis.statement}</p>
            <dl>
              <dt class="label">Metric</dt><dd id="hyp-metric">{read.hypothesis.metric}</dd>
              <dt class="label">Guardrail</dt><dd id="hyp-guardrail">{read.hypothesis.guardrail}</dd>
              <dt class="label">Decision rule</dt><dd id="hyp-rule">{read.hypothesis.decisionRule}</dd>
            </dl>
            <div class="btns" style="margin-top:0">
              <button class="btn ghost" type="button" data-hyp="accepted">Accept</button>
              <button class="btn ghost" type="button" data-hyp="edit">Edit</button>
              <button class="btn ghost" type="button" data-hyp="rejected">Reject</button>
              <button class="btn ghost" type="button" data-hyp="copy">Copy as text</button>
            </div>
            <p class="status" id="hyp-status" role="status"></p>
          </div>
        </div>
        <aside class="margin">
          <dl>
            <dt class="label">Tactics noted</dt><dd>{(read.tactics ?? []).join(', ').replace(/_/g, ' ') || 'none'}</dd>
            <dt class="label">Not seen, so not judged</dt><dd><ul style="padding-left:1.1em;margin:4px 0 0">{(read.unknowns ?? []).map((u: string) => <li>{u}</li>)}</ul></dd>
          </dl>
        </aside>
      </div>
    </>)}
  </section>

  <script type="application/json" id="exp-data" set:html={JSON.stringify(payload)} />
  <script>
    import { load, save, persistent } from '../scripts/store.js';
    const root = document.querySelector('[data-exp]') as HTMLElement;
    if (root) {
      const data = JSON.parse(document.getElementById('exp-data')!.textContent!);
      const id = data.id as string;
      const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector(s) as T;

      // ----- filmstrip -----
      const imgs = [...root.querySelectorAll<HTMLButtonElement>('.strip button')];
      const stageImg = $<HTMLImageElement>('#stage-img'), cap = $('#stage-cap'), ribbon = $('#ribbon'), scrub = $<HTMLInputElement>('#scrub'), noteStep = $('#note-step');
      const total = data.steps.length;
      const srcs = imgs.map((b) => b.querySelector('img')!.getAttribute('src')!);
      function go(n: number, push = true) {
        if (!total) return;
        n = Math.max(1, Math.min(total, n));
        const s = data.steps[n - 1];
        stageImg.src = srcs[n - 1]; stageImg.alt = `${s.kind} page ${n}: ${s.title}`;
        cap.innerHTML = `Pl. <span class="num">${n} / ${total}</span><span>${s.kind}</span><span class="num">${s.path}</span>`;
        ribbon.innerHTML = `<span class="label">Page <b class="num">${n}/${total}</b></span><span class="label">${s.kind}</span><span class="label num">${s.path}</span>`;
        scrub.value = String(n); scrub.setAttribute('aria-valuetext', `Page ${n} of ${total}, ${s.kind}, ${s.path}`);
        imgs.forEach((b, i) => b.setAttribute('aria-selected', String(i + 1 === n)));
        noteStep.textContent = s.title;
        if (push) history.replaceState(null, '', `#step=${n}`);
      }
      imgs.forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.step))));
      scrub.addEventListener('input', () => go(Number(scrub.value)));
      document.addEventListener('click', (e) => { const a = (e.target as HTMLElement).closest('[data-jump]') as HTMLElement | null; if (a) { e.preventDefault(); go(Number(a.dataset.jump)); document.getElementById('s-plates')?.scrollIntoView({ block: 'start' }); } });
      const m = location.hash.match(/step=(\d+)/); go(m ? Number(m[1]) : 1, false);

      // ----- hypothesis card (decision kept on this device only) -----
      const st = load();
      const hs = (st.hypotheses[id] ??= { status: 'pending' }); const hstat = $('#hyp-status');
      if (hstat) {
        const hshow = () => { hstat.textContent = hs.status === 'pending' ? '' : `Marked ${hs.status} on this device.`; };
        hshow();
        root.querySelectorAll<HTMLButtonElement>('[data-hyp]').forEach((b) => b.addEventListener('click', async () => {
          const a = b.dataset.hyp!;
          if (a === 'accepted' || a === 'rejected') { hs.status = a; save(); hshow(); }
          if (a === 'copy') {
            const txt = ['statement', 'metric', 'guardrail', 'rule'].map((k) => (k === 'statement' ? 'Hypothesis: ' : k[0].toUpperCase() + k.slice(1) + ': ') + $('#hyp-' + k).textContent).join('\n');
            try { await navigator.clipboard.writeText(txt); hstat.textContent = 'Copied.'; } catch { hstat.textContent = 'Copy blocked by the browser.'; }
          }
          if (a === 'edit') {
            const ids = ['metric', 'guardrail', 'rule'];
            if (b.dataset.editing) { ids.forEach((k) => { const ta = $<HTMLTextAreaElement>('#hyp-' + k + ' textarea'); hs.edited = { ...(hs.edited ?? {}), [k]: ta.value }; $('#hyp-' + k).textContent = ta.value; }); hs.status = 'edited'; save(); b.textContent = 'Edit'; delete b.dataset.editing; hshow(); }
            else { ids.forEach((k) => { const el = $('#hyp-' + k); const ta = document.createElement('textarea'); ta.value = el.textContent ?? ''; ta.setAttribute('aria-label', k); el.textContent = ''; el.appendChild(ta); }); b.textContent = 'Save'; b.dataset.editing = '1'; }
          }
        }));
        if (hs.edited) for (const [k, v] of Object.entries<string>(hs.edited)) { const el = root.querySelector('#hyp-' + k); if (el) el.textContent = v; }
        if (!persistent) hstat.textContent = 'This browser blocks storage; decisions will not survive a reload.';
      }
    }
  </script>
</article>
