---
import Base from '../layouts/Base.astro';
---
<Base title="Data" rail="Your data">
  <p class="label">Data</p>
  <h1 style="font-size:var(--t-h2);margin-top:8px">Your marks live on this device.</h1>
  <p class="lead">Scores, verdicts and hypothesis decisions are stored in this browser only. Nothing is sent anywhere. Moving to another browser means exporting here and importing there.</p>
  <p class="status" id="storage" role="status"></p>

  <section class="sec"><h2>Export</h2>
    <p id="summary" class="mute"></p>
    <div class="btns"><button class="btn" id="export" type="button">Download export</button></div>
  </section>
  <section class="sec"><h2>Import</h2>
    <label class="label" for="file">Export file</label><br />
    <input id="file" type="file" accept="application/json,.json" />
    <p class="status" id="imp" role="status"></p>
    <div class="btns"><button class="btn ghost" id="merge" type="button" disabled>Merge (newer wins)</button><button class="btn ghost" id="replace" type="button" disabled>Replace everything</button></div>
    <p class="mute">A backup of your current data downloads before any import.</p>
  </section>
  <section class="sec"><h2>Reset</h2>
    <p>Clears every score and decision on this device.</p>
    <div class="btns"><button class="btn ghost" id="reset" type="button">Clear this device</button></div>
    <p class="status" id="rst" role="status"></p>
  </section>
  <section class="sec"><h2>Rubric feedback and corrections</h2>
    <p>If a pro or con is wrong, or a score misses the real issue, open an issue on the project's repository. Corrections and takedown requests are read first.</p>
    <p><a href="https://github.com/mikeorme/merchant-growth-lab/issues/new">Open an issue</a></p>
  </section>
  <script>
    import { load, exportJson, validateImport, importData, reset, persistent } from '../scripts/store.js';
    const $ = (id: string) => document.getElementById(id)!;
    const st = load();
    const sum = () => { const n = Object.values<any>(load().scores).filter((s) => s.state !== 'unscored').length; $('summary').textContent = `${n} specimen${n === 1 ? '' : 's'} with marks, ${load().feedback.length} feedback notes.`; };
    sum();
    if (!persistent) $('storage').textContent = 'This browser blocks storage, so marks are held in memory and will be lost on reload. Export before leaving.';
    function download(name: string, text: string) { const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([text], { type: 'application/json' })); a.download = name; a.click(); URL.revokeObjectURL(a.href); }
    const stamp = () => new Date().toISOString().slice(0, 10);
    $('export').addEventListener('click', () => download(`mgl-export-${stamp()}.json`, exportJson()));
    let pending: any = null;
    ($('file') as HTMLInputElement).addEventListener('change', async (e) => {
      const f = (e.target as HTMLInputElement).files?.[0]; if (!f) return;
      try { pending = JSON.parse(await f.text()); } catch { pending = null; $('imp').textContent = 'That file is not valid JSON. Nothing was changed.'; return; }
      const errs = validateImport(pending);
      if (errs.length) { pending = null; $('imp').textContent = errs.join(' ') + ' Nothing was changed.'; return; }
      const n = Object.keys(pending.data.scores).length; $('imp').textContent = `Ready: ${n} specimens with marks, exported ${pending.exportedAt?.slice(0, 10)}.`;
      ($('merge') as HTMLButtonElement).disabled = false; ($('replace') as HTMLButtonElement).disabled = false;
    });
    for (const mode of ['merge', 'replace']) $(mode).addEventListener('click', () => {
      if (!pending) return; download(`mgl-backup-${stamp()}.json`, exportJson()); importData(pending, mode); sum(); $('imp').textContent = `Imported (${mode}). A backup of the previous data was downloaded.`;
    });
    $('reset').addEventListener('click', () => { if (confirm('Clear every score and decision on this device?')) { reset(); sum(); $('rst').textContent = 'Cleared.'; } });
  </script>
</Base>
