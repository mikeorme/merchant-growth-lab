---
import Base from '../layouts/Base.astro';
import { experiences, dims } from '../lib/data';
const lab = Object.fromEntries(experiences.map((e) => [e.id, Object.fromEntries(Object.entries(e.scores ?? {}).map(([k, v]) => [k, v.score]))]));
const names = Object.fromEntries(experiences.map((e) => [e.id, e.name]));
const MIN = 5;
---
<Base title="Calibration" rail="Ledger">
  <p class="label">Calibration</p>
  <h1 style="font-size:var(--t-h2);margin-top:8px">Where your marks and the Lab's part ways.</h1>
  <p class="lead">Only specimens you scored before opening the notes count. Skipped ones and "n/t" marks are left out and counted separately.</p>
  <div id="out"></div>
  <script type="application/json" id="cal-data" set:html={JSON.stringify({ lab, names, dims: dims.map((d) => ({ id: d.id, label: d.label })), min: MIN })} />
  <script>
    import { load } from '../scripts/store.js';
    const { lab, names, dims, min } = JSON.parse(document.getElementById('cal-data')!.textContent!);
    const st = load(); const out = document.getElementById('out')!;
    const done = Object.entries<any>(st.scores).filter(([id, r]) => lab[id] && !r.skipped && r.submittedAt && ['submitted', 'revealed'].includes(r.state));
    if (done.length < min) {
      out.innerHTML = `<p class="lead">${done.length} of ${min} specimens scored. Score ${min - done.length} more to see divergence.</p><p><a class="btn" href="../archive/?mine=no">Choose one to score</a></p>`;
    } else {
      const per = dims.map((d: any) => {
        const gaps: number[] = []; let nt = 0;
        for (const [id, r] of done) { const y = r.dims?.[d.id]; const l = lab[id][d.id]; if (!y || y.cantTell || l == null) { nt++; continue; } gaps.push(y.score - l); }
        const within = gaps.filter((g) => Math.abs(g) <= 1).length;
        return { d, n: gaps.length, nt, mean: gaps.length ? gaps.reduce((a, b) => a + b, 0) / gaps.length : null, within: gaps.length ? within / gaps.length : null };
      });
      const all = per.flatMap((p: any) => p.within == null ? [] : [p]);
      const agree = all.length ? all.reduce((a: number, p: any) => a + p.within * p.n, 0) / all.reduce((a: number, p: any) => a + p.n, 0) : 0;
      const pos = (g: number) => 50 + (g / 4) * 44;
      out.innerHTML = `<p class="lead"><span class="num">${Math.round(agree * 100)}%</span> of paired marks fall within one point, across <span class="num">${done.length}</span> specimens.</p>
      <div class="tablewrap"><table><thead><tr><th>Dimension</th><th>Your mark minus the Lab's</th><th>Mean gap</th><th>Within 1 pt</th><th>Pairs</th><th>n/t</th></tr></thead><tbody>${per.map((p: any) => `<tr><td>${p.d.label}</td><td><div class="track" style="width:200px" aria-hidden="true"><i style="left:50%;background:var(--ink)"></i>${p.mean == null ? '' : `<span class="dot you" style="left:${pos(p.mean)}%"></span>`}</div></td><td class="numc">${p.mean == null ? '<span class="nt">n/t</span>' : (p.mean > 0 ? '+' : '') + p.mean.toFixed(1)}</td><td class="numc">${p.within == null ? '' : Math.round(p.within * 100) + '%'}</td><td class="numc">${p.n}</td><td class="numc">${p.nt}</td></tr>`).join('')}</tbody></table></div>
      <p class="mute" style="margin-top:16px">Left of centre: you scored lower than the Lab. Right: higher. Scored on rubric v1.0.0.</p>`;
    }
  </script>
</Base>
